<?xml version="1.0" encoding="UTF-8"?>
<!-- Nexus Desktop per-user MSI (no administrator rights required).
     Build: scripts/release.ps1 (passes Version and ExePath). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Nexus Desktop"
           Manufacturer="Liam Catherine"
           Version="$(var.Version)"
           UpgradeCode="6D1E8B2A-4C7F-4E5B-9A3D-2F8C1B7E4A10"
           Scope="perUser"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Nexus Desktop is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="NexusIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="NexusIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ljcatherine/NexusWindows" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Nexus Desktop">
          <Component Id="MainExe" Guid="3F2A9C41-7B6E-4D85-A1C0-9E4B2D7F8A31">
            <File Id="NexusExe" Source="$(var.ExePath)" Name="NexusDesktop.exe" />
            <RegistryValue Root="HKCU" Key="Software\NexusDesktop" Name="installed" Type="integer" Value="1" KeyPath="yes" />
            <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
            <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="B8D47E12-5C3A-4F69-8E2B-1A7C6D9F0E42">
        <Shortcut Id="NexusShortcut" Name="Nexus Desktop" Description="Nexus IDE and infrastructure manager"
                  Target="[INSTALLFOLDER]NexusDesktop.exe" WorkingDirectory="INSTALLFOLDER" Icon="NexusIcon" />
        <RegistryValue Root="HKCU" Key="Software\NexusDesktop" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Nexus Desktop" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
